POSTGRES_USER=shorturl
POSTGRES_PASSWORD=shorturl
POSTGRES_DB=short_url_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB"
JWT_SECRET="chave-secreta"
HASHIDS_SALT="salt-para-hashids"

# Observabilidade (opcional). Quando false ou omitido, usa provider noop.
# OBSERVABILITY_ENABLED=true
# OBSERVABILITY_PROVIDER=sentry|console|noop
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# NODE_ENV=development|production
# LOG_LEVEL=info
# LOG_PRETTY=true
