# Copie para terraform.tfvars e preencha
# Variáveis sensíveis: export TF_VAR_api_jwt_secret=xxx TF_VAR_db_password=yyy

aws_region  = "us-east-1"
environment = "dev"

api_ssh_public_key_path = "~/.ssh/id_ed25519.pub"
api_github_repo         = "https://github.com/seu-usuario/short-url-api.git"
api_github_branch       = "main"

db_username = "shorturl"
# db_password = "DEFINIR_VIA_TF_VAR_db_password"
# api_jwt_secret = "DEFINIR_VIA_TF_VAR_api_jwt_secret"
